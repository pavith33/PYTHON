a=input("Enter any Password:")
uc=0
lc=0
d=0
sp=0
if len(a)>7:
    for i in a:
        if i.isupper():
            uc=uc+1
        elif i.islower():
            lc=lc+1
        elif i.isdigit():
            d=d+1
        else:
            sp=sp+1
    if uc>0 and lc>0 and d>0 and sp>0:
        print("Strong")
    else:
        print("Weak")
else:
    print("Weak")
