class Solution:
    def canPlaceFlowers(self, flowerbed: List[int], n: int) -> bool:
        c=0
        for i in range(len(flowerbed)):
            if flowerbed[i]==0:
                l=False
                r=False
                if i==0 or flowerbed[i-1]==0:
                    l=True
                if i==len(flowerbed)-1 or flowerbed[i+1]==0:
                    r=True
                if l==True and r==True:
                    flowerbed[i]=1
                    c=c+1
        return c>=n
