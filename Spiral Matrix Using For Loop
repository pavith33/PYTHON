a=[[33,18,45,97,10,83],
   [22,11,44,55,66,88],
   [12,13,14,15,16,19],
   [23,34,45,56,78,90],
   [27,54,76,98,74,54]]
top=0
bottom=len(a)-1
left=0
right=len(a[0])-1
while(top<=bottom and left<=right):
    for i in range(left,right+1):
        print(a[top][i],end=" ")
    top=top+1
    
    for i in range(top,bottom+1):
        print(a[i][right],end=" ")
    right=right-1
    if top<right:
        for i in range(right,left-1,-1):
            print(a[bottom][i],end=" ")
        bottom=bottom-1
    if right<left:
        for i in range(bottom,top-1,-1):
            print(a[i][left],end=" ")
        left=left-1

 
