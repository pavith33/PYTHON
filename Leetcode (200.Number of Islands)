class Solution:
    def numIslands(self, grid: List[List[str]]) -> int:
        row=len(grid)
        col=len(grid[0])
        count=0
        for i in range(row):
            for j in range(col):
                if grid[i][j]=="1":
                    count=count+1
                    stack=[(i,j)]
                    while(stack):
                        r,c=stack.pop()
                        if r<0 or c<0 or c>=col or r>=row:
                            continue
                        if grid[r][c]=="0":
                            continue
                        grid[r][c]="0"
                        stack.append((r+1,c))
                        stack.append((r-1,c))
                        stack.append((r,c+1))
                        stack.append((r,c-1))                
        return count
